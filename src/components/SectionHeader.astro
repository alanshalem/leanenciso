---
interface Props {
  num: string;
  title: string;
  kicker?: string;
  id?: string;
  /** Marca esta seccion en la scrub bar. */
  marker?: boolean;
}

const { num, title, kicker, id, marker = true } = Astro.props;
---

<header class="sec" id={id} data-sec={marker ? title : undefined}>
  <p class="sec__label">
    <span class="sec__num">SEC {num}</span>
    {kicker && <span class="sec__kicker">{kicker}</span>}
  </p>
  <h2 class="t-sec sec__title" data-reveal-self>{title}</h2>
</header>

<style>
  .sec {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .sec__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sec__num {
    color: var(--color-acid);
  }

  .sec__kicker {
    color: var(--muted);
    position: relative;
    padding-left: 1rem;
  }
  .sec__kicker::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.5rem;
    height: 1px;
    background: var(--line-strong);
  }

  .sec__title {
    max-width: 18ch;
  }
</style>
