---
// Scrub bar de la timeline: el scroll es el playhead.
// scrubber.ts calcula progreso, timecode y marcadores de seccion.
---

<div class="scrub" aria-hidden="true">
  <div class="scrub__meta">
    <span class="scrub__rec"></span>
    <span class="scrub__tc" data-scrub-time>00:00:00:00</span>
    <span class="scrub__sep">/</span>
    <span class="scrub__tc scrub__tc--dim" data-scrub-total>00:00:00:00</span>
  </div>
  <div class="scrub__hit" data-scrub-track>
    <div class="scrub__track">
      <div class="scrub__fill" data-scrub-fill></div>
    </div>
    <div class="scrub__markers" data-scrub-markers></div>
  </div>
</div>

<style>
  .scrub {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 70;
    pointer-events: none;
    padding-inline: var(--gutter);
    background: linear-gradient(to top, var(--color-ink) 35%, transparent);
    padding-top: 2.5rem;
  }

  .scrub__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: flex-end;
    padding-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .scrub__rec {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 99px;
    background: var(--color-rec);
    margin-right: 0.25rem;
    animation: blink 2s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.15;
    }
  }

  .scrub__tc {
    color: var(--color-paper);
  }
  .scrub__tc--dim {
    color: var(--dim);
  }
  .scrub__sep {
    color: var(--dim);
  }

  /* Area de click generosa; la linea visible sigue siendo de 2px. */
  .scrub__hit {
    position: relative;
    pointer-events: auto;
    cursor: pointer;
    padding-block: 0.625rem;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }

  .scrub__track {
    height: 2px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }

  .scrub__fill {
    position: absolute;
    inset: 0;
    background: var(--color-acid);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .scrub__markers {
    position: absolute;
    inset: 0.625rem var(--gutter) auto;
    height: 2px;
    pointer-events: none;
  }

  .scrub__markers :global(.scrub-marker) {
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    background: var(--color-paper);
    transform: translateY(-50%) rotate(45deg);
    pointer-events: auto;
    opacity: 0.45;
    transition:
      opacity 0.2s,
      background 0.2s;
  }

  .scrub__markers :global(.scrub-marker:hover) {
    opacity: 1;
    background: var(--color-acid);
  }

  @media (max-width: 40rem) {
    .scrub__meta {
      font-size: 0.625rem;
    }
  }
</style>
