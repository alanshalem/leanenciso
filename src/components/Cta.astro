---
import { Icon } from 'astro-icon/components';
import { canales } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = '¿Tenés material y no sabés qué hacer con él?',
  body = 'Mandame el crudo y vemos qué se puede sacar de ahí.',
} = Astro.props;

// Sin canales cargados no hay a dónde mandar a nadie: el bloque no se muestra.
const botones = canales.slice(0, 3);
---

{
  botones.length > 0 && (
    <section class="cta">
      <div class="wrap cta__inner" data-reveal>
        <h2 class="cta__title">{title}</h2>
        <p class="cta__body">{body}</p>
        <div class="cta__actions">
          {botones.map((canal, i) => (
            <a
              class:list={['btn', { 'btn--acid': i === 0 }]}
              href={canal.href}
              target={canal.external ? '_blank' : undefined}
              rel={canal.external ? 'noopener' : undefined}
              data-cursor-label={i === 0 ? 'ESCRIBIR' : undefined}
            >
              {canal.key === 'email' ? 'Escribime' : canal.label}
              <Icon name="lucide:arrow-up-right" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .cta {
    padding-block: clamp(4rem, 12vw, 10rem);
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .cta__title {
    font-size: clamp(2rem, 6vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    max-width: 16ch;
  }

  .cta__body {
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: var(--muted);
    max-width: 48ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .btn svg {
    width: 0.9rem;
    height: 0.9rem;
    transition: translate 0.3s var(--ease-out-expo);
  }
  .btn:hover svg {
    translate: 0.15rem -0.15rem;
  }
  .btn:hover {
    border-color: var(--color-paper);
  }

  .btn--acid {
    background: var(--color-acid);
    color: var(--color-ink);
    border-color: var(--color-acid);
  }
  .btn--acid:hover {
    background: transparent;
    color: var(--color-acid);
    border-color: var(--color-acid);
  }
</style>
